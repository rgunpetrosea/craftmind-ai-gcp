# --- Gemini (Google AI Studio) ---------------------------------------------
# Leave empty to run fully offline with heuristic agents + SVG mockups.
GEMINI_API_KEY=

# --- or Vertex AI (uses Application Default Credentials) --------------------
# GOOGLE_GENAI_USE_VERTEXAI=true
GCP_PROJECT_ID=your_project_id
# GCP_LOCATION=us-central1

# --- Model routing (optional overrides) --------------------------------------
# GEMINI_FLASH_MODEL=gemini-flash-latest
# GEMINI_FLASH_FALLBACK_MODEL=gemini-flash-lite-latest
# GEMINI_PRO_MODEL=gemini-pro-latest
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image   # image models need a billing-enabled key (free-tier quota is 0)
# IMAGEN_MODEL=imagen-4.0-generate-001

# --- Persistence (Google Cloud) ----------------------------------------------------
# true = Cloud Firestore (firebase-admin + Application Default Credentials; automatic on Cloud Run).
# Collections: orders (+ messages), chat_sessions, specifications, critic_reviews, crafter_workspaces, inventory, presets.
# Locally: `gcloud auth application-default login` and set GCP_PROJECT_ID. Otherwise an in-memory demo store.
USE_FIRESTORE=false
# Cloud Storage bucket for mockups, sketches and voice notes (orders then hold URLs, not inline images).
# Strongly recommended with USE_FIRESTORE (Firestore documents are limited to 1 MiB).
# GCS_BUCKET=craftmind-media
# false = private bucket, media served via /api/media/<path>; default true = public storage.googleapis.com URLs
# GCS_PUBLIC_READ=true
# Absolute origin for app links (client gallery, /api/media), e.g. the Cloud Run service URL
# PUBLIC_BASE_URL=https://craftmind-xxxx.a.run.app
# Signs the mock crafter session cookie (demo logins: leather_artisan / wood_artisan, password craft123)
# AUTH_SECRET=change-me
# Default crafter workspace (multi-crafter: route events with crafter_id or the workspace's wa_phone_number_id)
# CRAFTER_ID=crafter-leather-01

# --- Takeover & debounce tuning -----------------------------------------------
# Crafter first names that trigger a human takeover ("mau ngomong sama mas Fendy")
# CRAFTER_NAMES=fendy
# Crafter's WhatsApp number for escalation alerts (needs WA_ACCESS_TOKEN + WA_PHONE_NUMBER_ID)
# CRAFTER_WA_NUMBER=+62812xxxxxxx
# PARTIAL_PAUSE_MINUTES=30
# CONFUSION_STRIKE_LIMIT=3
# DEBOUNCE_BASE_MS=4000
# DEBOUNCE_MIN_MS=2000
# DEBOUNCE_MAX_WAIT_MS=15000

# --- Optional: real WhatsApp Cloud API delivery -------------------------------
# WA_ACCESS_TOKEN=
# WA_PHONE_NUMBER_ID=
# WA_GRAPH_VERSION=v21.0
# AI render rounds per session (products with a detail macro shot get the _DETAIL budget)
# MAX_AI_MOCKUP_RENDERS=6
# MAX_AI_MOCKUP_RENDERS_DETAIL=6
# AI replies per session: crafter hand-over at the cap, warning a little before it
# SESSION_TURN_CAP=20
# SESSION_TURN_WARNING=18

# --- Design Intelligence Layer v2: design critic & revision loop ----------------
# DESIGN_CRITIC=on                   # automatic critic loop in live chat (default off: one fast render pass, crafter approves)
# CRITIC_THRESHOLD=80                # gated criteria must reach this (set NEXT_PUBLIC_CRITIC_THRESHOLD too for the dashboard)
# MAX_CRITIC_REVISIONS=2             # automatic revision cycles before escalating to the crafter
# MAX_CRITIC_PASSES_PER_ORDER=24     # cost guardrail: vision critic calls per order
