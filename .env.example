# --- Gemini (Google AI Studio) ---------------------------------------------
# Leave empty to run fully offline with heuristic agents + SVG mockups.
GEMINI_API_KEY=

# --- or Vertex AI (uses Application Default Credentials) --------------------
# GOOGLE_GENAI_USE_VERTEXAI=true
GCP_PROJECT_ID=your_project_id
# GCP_LOCATION=us-central1

# --- Model routing (optional overrides) --------------------------------------
# GEMINI_FLASH_MODEL=gemini-flash-latest
# GEMINI_FLASH_FALLBACK_MODEL=gemini-flash-lite-latest
# GEMINI_PRO_MODEL=gemini-pro-latest
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# IMAGEN_MODEL=imagen-4.0-generate-001

# --- Persistence --------------------------------------------------------------
# true = Firestore (firebase-admin + ADC); otherwise in-memory demo store
USE_FIRESTORE=false
# Upload mockups / sketches to this bucket instead of inline data URLs
# GCS_BUCKET=craftmind-media

# --- Takeover & debounce tuning -----------------------------------------------
# Crafter first names that trigger a human takeover ("mau ngomong sama mas Fendy")
# CRAFTER_NAMES=fendy
# PARTIAL_PAUSE_MINUTES=30
# CONFUSION_STRIKE_LIMIT=3
# DEBOUNCE_BASE_MS=4000
# DEBOUNCE_MAX_WAIT_MS=15000

# --- Optional: real WhatsApp Cloud API delivery -------------------------------
# WA_ACCESS_TOKEN=
# WA_PHONE_NUMBER_ID=
# WA_GRAPH_VERSION=v21.0
